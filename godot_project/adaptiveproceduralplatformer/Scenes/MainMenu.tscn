content_margin_bottom = 12.0

[sub_resource type="StyleBoxFlat" id="BackgroundStyle"]
bg_color = Color(0.08, 0.08, 0.08, 0.95)

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
